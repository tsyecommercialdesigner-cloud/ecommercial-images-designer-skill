+    assert!(
+        before
+            .outcome()
+            .skills
+            .iter()
+            .any(|skill| skill.scope == SkillScope::System)
+    );
+    let cache = codex_skills::system_cache_root_dir(&codex_home.path().abs());
+    let marker = cache.join(".codex-system-skills.marker");
+    fs::write(&marker, "corrupted fixture").unwrap();
+    let after = service
+        .for_request()
+        .snapshot_for_cwd(&input, false, Some(Arc::clone(&LOCAL_FS)))
+        .await;
+    assert!(
+        after
+            .outcome()
+            .skills
+            .iter()
+            .all(|skill| skill.scope != SkillScope::System)
+    );
+    assert!(
+        after
+            .outcome()
+            .skills
+            .iter()
+            .any(|skill| skill.name == "user-skill")
+    );
+    assert_eq!(fs::read_to_string(marker).unwrap(), "corrupted fixture");
+}
