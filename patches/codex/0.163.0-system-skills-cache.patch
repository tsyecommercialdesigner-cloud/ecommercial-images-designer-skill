+#[test]
+#[ignore = "entry point used only by the cross-process parent test"]
+fn installer_child() {
+    let dir = std::env::var_os("CODEX_CACHE_TEST_HOME").expect("owned fixture home");
+    let variant = std::env::var("CODEX_CACHE_TEST_VARIANT").unwrap();
+    let home = home(Path::new(&dir));
+    fs::write(home.join(format!("ready-{}", std::process::id())), b"ready").unwrap();
+    let deadline = Instant::now() + Duration::from_secs(30);
+    while !home.join("go").exists() {
+        assert!(Instant::now() < deadline, "start barrier timed out");
+        std::thread::sleep(Duration::from_millis(5));
+    }
+    let dest = if variant == "current" {
+        system_cache_root_dir(&home)
+    } else {
+        home.join("skills/.system-cache-v2").join(&variant)
+    };
+    let fingerprint = if variant == "current" {
+        embedded_system_skills_fingerprint()
+    } else {
+        variant
+    };
+    install_system_skills_at(&dest, &fingerprint).unwrap();
+    for _ in 0..20 {
+        verify_published_cache(&dest, &fingerprint).unwrap();
+        std::thread::yield_now();
+    }
+}
