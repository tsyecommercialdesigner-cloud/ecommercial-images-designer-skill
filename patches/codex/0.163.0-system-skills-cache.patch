+//! Native filesystem and cross-process tests; no model, MCP, or user home access.
+use super::*;
+use std::process::Command;
+use std::time::Duration;
+use std::time::Instant;
+
+fn home(path: &Path) -> AbsolutePathBuf {
+    AbsolutePathBuf::try_from(path).expect("absolute fixture home")
+}
+
+#[test]
+fn published_cache_is_complete_and_warm_start_is_read_only() {
+    let fixture = tempfile::tempdir().unwrap();
+    let home = home(fixture.path());
+    install_system_skills(&home).unwrap();
+    let dest = system_cache_root_dir(&home);
+    verify_published_cache(&dest, &embedded_system_skills_fingerprint()).unwrap();
+    let marker = dest.join(SYSTEM_SKILLS_MARKER_FILENAME);
+    let modified = fs::metadata(&marker).unwrap().modified().unwrap();
+    install_system_skills(&home).unwrap();
+    assert_eq!(fs::metadata(&marker).unwrap().modified().unwrap(), modified);
+}
+
+#[test]
+fn legacy_other_versions_and_abandoned_staging_are_preserved() {
+    let fixture = tempfile::tempdir().unwrap();
+    let home = home(fixture.path());
+    let legacy = home.join("skills/.system/in-use.txt");
+    fs::create_dir_all(legacy.parent().unwrap()).unwrap();
+    fs::write(&legacy, "legacy reader").unwrap();
+    let parent = home.join("skills/.system-cache-v2");
+    let other = parent.join("other-build");
+    install_system_skills_at(&other, "other-build").unwrap();
+    let abandoned = parent.join(".staging-crashed");
+    fs::create_dir_all(&abandoned).unwrap();
+    fs::write(abandoned.join("partial"), "unpublished").unwrap();
+    install_system_skills(&home).unwrap();
+    assert_eq!(fs::read_to_string(&legacy).unwrap(), "legacy reader");
+    verify_published_cache(&other, "other-build").unwrap();
+    assert_eq!(
+        fs::read_to_string(abandoned.join("partial")).unwrap(),
+        "unpublished"
+    );
+    assert_ne!(system_cache_root_dir(&home), other);
+}
