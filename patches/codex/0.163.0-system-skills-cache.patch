+#[test]
+fn simultaneous_processes_publish_complete_isolated_caches() {
+    // Two different identities exercise path isolation; both use this build's
+    // actual embedded bytes. This is not a two-binary host compatibility test.
+    for _ in 0..4 {
+        let fixture = tempfile::tempdir().unwrap();
+        let home = home(fixture.path());
+        let exe = std::env::current_exe().unwrap();
+        let mut children = Vec::new();
+        for index in 0..8 {
+            children.push(
+                Command::new(&exe)
+                    .args([
+                        "--exact",
+                        "system_cache_tests::installer_child",
+                        "--ignored",
+                    ])
+                    .env("CODEX_CACHE_TEST_HOME", fixture.path())
+                    .env(
+                        "CODEX_CACHE_TEST_VARIANT",
+                        if index % 2 == 0 {
+                            "current"
+                        } else {
+                            "other-build"
+                        },
+                    )
+                    .spawn()
+                    .unwrap(),
+            );
+        }
+        let deadline = Instant::now() + Duration::from_secs(30);
+        while fs::read_dir(fixture.path())
+            .unwrap()
+            .filter(|entry| {
+                entry
+                    .as_ref()
+                    .unwrap()
+                    .file_name()
+                    .to_string_lossy()
+                    .starts_with("ready-")
+            })
+            .count()
+            != children.len()
+        {
+            assert!(Instant::now() < deadline, "children did not reach barrier");
+            std::thread::sleep(Duration::from_millis(5));
+        }
+        fs::write(home.join("go"), b"go").unwrap();
+        // While writers run, every visible published path must already be complete.
+        loop {
+            let mut running = false;
+            for child in &mut children {
+                running |= child.try_wait().unwrap().is_none();
+            }
+            for (dest, fingerprint) in [
+                (
+                    system_cache_root_dir(&home),
+                    embedded_system_skills_fingerprint(),
+                ),
+                (
+                    home.join("skills/.system-cache-v2/other-build"),
+                    "other-build".to_string(),
+                ),
+            ] {
+                if dest.exists() {
+                    verify_published_cache(&dest, &fingerprint).unwrap();
+                }
+            }
+            if !running {
+                break;
+            }
+            assert!(Instant::now() < deadline, "installer processes timed out");
+            std::thread::sleep(Duration::from_millis(1));
+        }
+        for child in &mut children {
+            assert!(child.wait().unwrap().success(), "installer child failed");
+        }
+        verify_published_cache(
+            &system_cache_root_dir(&home),
+            &embedded_system_skills_fingerprint(),
+        )
+        .unwrap();
+        verify_published_cache(
+            &home.join("skills/.system-cache-v2/other-build"),
+            "other-build",
+        )
+        .unwrap();
+    }
+}
